{
    "name": "happenv/filament-user-profile",
    "description": "Simple filament user profile.",
    "keywords": [
        "filament",
        "laravel",
        "user",
        "profile"
    ],
    "homepage": "https://github.com/webard/filament-user-profile",
    "license": "MIT",
    "authors": [
        {
            "name": "webard",
            "email": "code@webard.me",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.0.9",
        "illuminate/contracts": "^11.0|^12.0",
        "jenssegers/agent": "^2.6",
        "spatie/laravel-package-tools": "^1.14.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.0|^3.0",
        "laravel/pint": "^1.0",
        "laravel/sanctum": "^4.0",
        "orchestra/testbench": "^8.8|^9.0|^10.0",
        "pestphp/pest": "^2.20|^3.7",
        "pestphp/pest-plugin-arch": "^2.0|^v3.0.0",
        "pestphp/pest-plugin-laravel": "^2.0|^v3.1.0",
        "pestphp/pest-plugin-livewire": "^2.1|^v3.0.0"
    },
    "autoload": {
        "psr-4": {
            "Happenv\\FilamentUserProfile\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Happenv\\FilamentUserProfile\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Happenv\\FilamentUserProfile\\FilamentUserProfileServiceProvider"
            ],
            "aliases": {
                "FilamentUserProfile": "Happenv\\FilamentUserProfile\\Facades\\FilamentUserProfile"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
